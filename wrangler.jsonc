{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lounj",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "observability": { "enabled": true }
  // Optional, add later:
  // "kv_namespaces": [{ "binding": "LOUNJ_KV", "id": "<kv id>" }]   // saves booking requests & claims
  // Secrets (Cloudflare dashboard > Worker > Settings > Variables):
  //   GOOGLE_PLACES_KEY  -> switches listings to Google Places (ratings, photos)
  //   ADMIN_TOKEN        -> lets you view requests at /api/requests?token=...
}
